{
  "name": "bun-starter-kit",
  "type": "module",
  "module": "src/index.ts",
  "imports": {
    "#packages/*": "./packages/*"
  },
  "scripts": {
    "start:dev": "bun --watch run src/index.ts",
    "type:check": "tsc --noEmit",
    "format": "prettier . --write",
    "lint:fix": "eslint --fix .",
    "prepare": "husky"
  },
  "lint-staged": {
    "**/*": [
      "eslint --fix --cache",
      "prettier --write --ignore-unknown"
    ]
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.3.13",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-perfectionist": "^5.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "3.8.3",
    "typescript-eslint": "^8.59.2"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "private": true
}
