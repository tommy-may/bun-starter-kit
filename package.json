{
  "name": "bun-starter-kit",
  "type": "module",
  "module": "src/index.ts",
  "imports": {
    "#prettier-config": "./packages/prettier-config/index.js",
    "#eslint-config": "./packages/eslint-config/index.js"
  },
  "scripts": {
    "start:dev": "bun --watch run src/index.ts",
