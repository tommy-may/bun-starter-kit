{
  "name": "bun-starter-kit",
  "type": "module",
  "module": "src/index.ts",
  "imports": {
    "#prettier-config": "./packages/prettier-config/index.js",
    "#eslint-config": "./packages/eslint-config/index.js"
  },
  "scripts": {
    "start:dev": "bun --watch run src/index.ts",
    "type:check": "tsc --noEmit",
    "format": "prettier . --write",
    "lint:fix": "eslint --fix .",
    "prepare": "husky"
  },
  "lint-staged": {
    "**/*": [
      "eslint --fix --cache",
      "prettier --write --ignore-unknown"
    ]
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.3.12",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-perfectionist": "^5.8.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "3.8.3",
    "typescript-eslint": "^8.58.2"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "private": true
}
